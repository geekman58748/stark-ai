{
  "name": "@stark/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "NEAR vault contract (Rust). Scripts are not turbo tasks, so the JS pipeline runs without a Rust toolchain.",
  "scripts": {
    "contract:test": "cargo test --manifest-path vault/Cargo.toml",
    "contract:check": "cargo check --manifest-path vault/Cargo.toml --target wasm32-unknown-unknown",
    "contract:build": "cargo build --manifest-path vault/Cargo.toml --target wasm32-unknown-unknown --release"
  }
}
