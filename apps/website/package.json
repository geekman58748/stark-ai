{
  "name": "@stark/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing site for hellostark.xyz. React Router framework mode, pre-rendered to static HTML in build/client.",
  "scripts": {
    "dev": "react-router dev --port 5173",
    "build": "react-router build",
    "start": "vite preview --outDir build/client --port 5173",
    "clean": "git clean -xdf .react-router .turbo build node_modules",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@stark/ui": "workspace:*",
    "isbot": "^5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@stark/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
