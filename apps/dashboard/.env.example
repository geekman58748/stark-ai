# Neon Auth, from the browser. Copy to `.env` (gitignored) to sign in locally.
# The branch's Auth URL, ending in `/auth` — Neon console → Auth → Configuration.
# The same project also issues the sessions the API verifies, so `DATABASE_URL`
# in apps/backend/.env must point at the same branch.
VITE_NEON_AUTH_URL=

# Leave empty in development: Vite proxies /v1 to 127.0.0.1:8000.
# VITE_STARK_API_URL=
