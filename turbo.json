{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env"],
  "ui": "stream",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".output/**", ".react-router/**"],
      "env": ["VITE_*"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NEAR_AI_*", "VTPASS_*", "TELEGRAM_*", "STARK_*", "VITE_STARK_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
