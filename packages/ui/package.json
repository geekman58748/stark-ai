{
  "name": "@stark/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "description": "Stark's design system: shadcn/ui on Base UI, themed with Stark's tokens, fonts and Reicon icons.",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./globals.css": "./src/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.tsx",
    "./utils/*": "./src/utils/*.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@stark/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "reicon-react": "catalog:",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@stark/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
