{
  "name": "@stark/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Typed client for the backend's /v1 contract (docs/API.md), plus TanStack Query options and mutations.",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./client": "./src/client.ts",
    "./queries": "./src/queries.ts",
    "./mutations": "./src/mutations.ts",
    "./errors": "./src/errors.ts"
  },
  "dependencies": {
    "@stark/utils": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@stark/tsconfig": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
